# Copy to ./.env (repo root) and fill in. Used both for docker-compose variable
# substitution and as the server's env_file. Never commit the filled-in file.
# The full list of server settings, with explanations, is in .env.example.

# --- Domain ------------------------------------------------------------------
# A DNS name pointing at this machine, ports 80/443 open. Caddy gets a free
# TLS certificate for it. This is the URL people type into the app's
# Settings > Network > Server URL (https://<this name>).
NANB_DOMAIN=chat.example.org

# --- Postgres (bundled in docker-compose.yml) --------------------------------
POSTGRES_USER=nanb
POSTGRES_PASSWORD=CHANGE-ME-to-a-long-random-string
POSTGRES_DB=nanb
# Must match the three values above. sslmode=disable is fine only because the
# database sits on the private compose network; use require for a remote DB.
NANB_PG_CONN=postgres://nanb:CHANGE-ME-to-a-long-random-string@postgres:5432/nanb?sslmode=disable

# --- Session signing key (REQUIRED) ------------------------------------------
# Generate once and keep it stable, or every session is signed out on restart:
#   go run ./cmd/genkey
NANB_JWT_PRIV_KEY_B64=

# --- Listeners ---------------------------------------------------------------
NANB_LISTEN_ADDR=:8080
# Tor onion service (optional): bind a bridge-reachable address for the tor
# sidecar. Unset to disable the onion listener.
NANB_TOR_LISTEN_ADDR=0.0.0.0:8081

# --- Optional features (all off when unset) ----------------------------------
# Media (photos, files, voice notes) needs S3 storage; see SELF_HOSTING.md.
# Without it, text messaging and calls still work.
# NANB_AWS_REGION=us-east-1
# NANB_S3_BUCKET=your-bucket
#
# Push notifications (Android FCM / iOS APNs), GIF search (NANB_GIPHY_API_KEY),
# voice-call relay (NANB_TURN_AUTH_SECRET + NANB_TURN_URLS), abuse-report email
# (NANB_SMTP_*): see .env.example.
