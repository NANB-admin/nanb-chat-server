# nanb-server environment variables. Copy to .env and adjust per environment.

## Required ----------------------------------------------------------------

# PostgreSQL connection string. The default below is LOCAL-DEV ONLY (hardcoded
# password, sslmode=disable) — OVERRIDE it in production. Leaving it unset outside
# NANB_DEV_MODE logs a startup WARNING (a forgotten prod NANB_PG_CONN).
NANB_PG_CONN=postgres://nanbchatapp:password@localhost:5432/nanb_chat_app?sslmode=disable

# Ed25519 private key (64 bytes) for signing JWTs, base64-stdandard-encoded.
# Generate with:  openssl genpkey -algorithm ed25519 | openssl pkey -outform DER | tail -c 32 | base64
# (or use a one-shot Go helper). If unset, server generates an ephemeral key per boot — do NOT use in prod.
NANB_JWT_PRIV_KEY_B64=

# Local-development toggle. When true, the server may boot with an ephemeral JWT
# key (see above) and the insecure default NANB_PG_CONN without warnings. MUST be
# unset/false in production (prod then fails closed on a missing JWT key and warns
# on the default DB conn).
NANB_DEV_MODE=false

## Network -----------------------------------------------------------------

# Clearnet HTTP listen address. Default :8080.
NANB_LISTEN_ADDR=:8080

# Tor onion HTTP listen address (binds to 127.0.0.1 only; the Tor sidecar forwards traffic here).
# Leave unset to disable the Tor listener.
NANB_TOR_LISTEN_ADDR=127.0.0.1:8081

## Object storage (S3) ----------------------------------------------------

# AWS region + bucket for media blobs. If either is unset, media uploads will fail
# with a 500 (server still boots; suitable for local dev).
NANB_AWS_REGION=us-east-1
NANB_S3_BUCKET=nanb-media-prod

# Optional CloudFront signing for media downloads. When NANB_CDN_DOMAIN + KEY_ID
# + a private key (inline NANB_CDN_PRIVATE_KEY, or NANB_CDN_PRIVATE_KEY_FILE path)
# are ALL set, media.GetDownload returns a CloudFront signed URL; otherwise it
# falls back to an S3 presigned GET. A partial/invalid config logs a WARN and
# uses S3 (never fails boot).
NANB_CDN_DOMAIN=
NANB_CDN_KEY_ID=
NANB_CDN_PRIVATE_KEY_FILE=
# NANB_CDN_PRIVATE_KEY=   # inline PEM alternative to the _FILE path above

## Push notifications ----------------------------------------------------

# APNs (iOS). Leave APNS vars unset to disable direct APNs.
#
# REQUIRED FOR THE iOS CALLKIT RING. Ordinary iOS message pushes go out through
# FCM (which forwards to APNs for us), so this block used to be optional — but a
# PushKit/VoIP push CANNOT go through FCM: it needs `apns-push-type: voip` on
# the `<bundle>.voip` topic, which only a direct APNs connection can set. With
# these unset the server logs "VoIP (CallKit) ring disabled" at boot and iOS
# calls fall back to a plain alert banner, which does not ring a locked phone.
#
# KEY_PATH is the `.p8` auth key (the SAME key Firebase holds for the alert
# path — one key serves both). KEY_ID is its 10-char id, TEAM_ID the Apple team.
NANB_APNS_KEY_PATH=/etc/nanb/apns_authkey.p8
NANB_APNS_KEY_ID=ABCDEFGHIJ
NANB_APNS_TEAM_ID=ABCDEFGHIJ
NANB_APNS_BUNDLE_ID=com.example.nanb
# Which APNs environment to TRY FIRST for the VoIP ring. It is only a
# preference: a PushKit token belongs to the environment the app was signed for,
# and a fleet legitimately mixes them (TestFlight = production, the same commit
# sideloaded with a development profile = sandbox), so the client automatically
# retries the other host on the one rejection that means "wrong environment".
# Set true when most devices run store/TestFlight builds.
NANB_APNS_PRODUCTION=false

# FCM (Android). Leave NANB_FCM_SERVICE_ACCOUNT_PATH unset to disable Android push.
NANB_FCM_SERVICE_ACCOUNT_PATH=/etc/nanb/firebase_service_account.json

## Tunables --------------------------------------------------------------
# Each value below is bounded by a hardcoded MAX (= the listed default).
# Operators can LOWER any limit (smaller cap, shorter retention, smaller
# media size) for tighter privacy or smaller deployments — they cannot
# raise them above the default. Invalid or out-of-range values fall back
# to the default; clamped values log a WARN at boot.

# Per-conversation envelope FIFO cap. When a conversation exceeds this
# count, the oldest unacked envelopes are evicted on the next submit.
NANB_CONVERSATION_CAP=5000

# Days to retain undelivered envelopes before the retention worker
# deletes them. Default + max = 30.
NANB_ENVELOPE_RETENTION_DAYS=30

# Days to retain media blobs (S3 + DB row) before the retention worker
# evicts them. Default + max = 30.
NANB_MEDIA_RETENTION_DAYS=30

# Maximum encrypted media size accepted by /media/init, in megabytes.
NANB_MEDIA_MAX_SIZE_MB=100

# Maximum ratchet ciphertext size accepted by /messages, in kilobytes.
NANB_MESSAGE_MAX_SIZE_KB=1024

# Lifetime of S3 presigned upload/download URLs, in minutes.
NANB_PRESIGN_TTL_MINUTES=15

# Lifetime of newly-issued session JWTs, in hours.
NANB_JWT_LIFETIME_HOURS=24

# Lifetime of login challenge nonces, in seconds.
NANB_CHALLENGE_LIFETIME_SECONDS=120

# Lifetime of stored key packages (Plan 6 prekeys), in days.
NANB_KEY_PACKAGE_LIFETIME_DAYS=30

# How often the retention worker scans for expired media, in minutes.
NANB_RETENTION_INTERVAL_MINUTES=60

# Max number of expired media records the retention worker processes per
# scan tick. Higher = catches up faster after downtime; lower = smoother
# load on S3/DB.
NANB_RETENTION_BATCH=100

# Maximum members per MLS group. Hard upper bound is 32 (mobile MLS
# Commit processing is O(N²) in tree size — going higher risks UI jank).
NANB_GROUP_MAX_MEMBERS=32

# ── TURN (WebRTC 1:1 calls) ────────────────────────────────────────────────
# coturn use-auth-secret shared secret. Must match coturn's `static-auth-secret`.
# Unset = the /turn/credentials endpoint returns 503 and calls fall back to
# direct/STUN candidates (only work on cooperative NATs). Generate with e.g.
# `openssl rand -hex 32`.
NANB_TURN_AUTH_SECRET=

# Comma-separated ICE/TURN URIs handed to clients. Relay-only privacy means
# clients use these as their only servers. Example (TLS/TCP on 443 so it also
# works through restrictive networks / can be tunnelled over Tor):
#   turns:turn.example.org:443?transport=tcp,turn:turn.example.org:3478?transport=udp
NANB_TURN_URLS=

# Lifetime of an issued TURN credential, in seconds (default 12h, cap 24h).
NANB_TURN_TTL_SECONDS=43200

# ── Giphy (in-app GIF picker) ──────────────────────────────────────────────
# Server-side Giphy API key. Unset = the /gifs/* endpoints are disabled. Used
# server-side ONLY (never shipped to clients); GIF requests are proxied so the
# client never talks to Giphy directly.
NANB_GIPHY_API_KEY=

# ── Moderation report email (optional) ─────────────────────────────────────
# A filed user report is ALWAYS stored; if these are set it is ALSO emailed.
# Unset NANB_SMTP_HOST or NANB_REPORT_EMAIL_TO = stored only (no email alert).
NANB_SMTP_HOST=
NANB_SMTP_PORT=587
NANB_SMTP_USERNAME=
NANB_SMTP_PASSWORD=
NANB_REPORT_EMAIL_TO=
# From address; defaults to NANB_SMTP_USERNAME when unset.
NANB_REPORT_EMAIL_FROM=
